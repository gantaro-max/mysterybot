<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gantaro.mysterybot.repository.RiddleRepository">

  <select id="findByGroupIdAndStageNo" resultType="com.gantaro.mysterybot.entity.Riddle">
    SELECT * FROM riddles WHERE group_id = #{groupId} AND stage_no = #{stageNo}
  </select>

  <select id="countByGroup" resultType="int">
    SELECT COUNT(*) FROM riddles WHERE group_id = #{groupId}
  </select>

  <select id="findAllByGroup" resultType="com.gantaro.mysterybot.entity.Riddle">
    SELECT * FROM riddles WHERE group_id = #{groupId}
  </select>

</mapper>